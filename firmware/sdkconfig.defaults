# Startwerte für sdkconfig. sdkconfig selbst steht nicht im Repository.

# Platine ESP32-S3-DevKitC-1 N16R8: 16 MB Flash. Den PSRAM nutzt die
# Firmware nicht, sie legt alles statisch an.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Task-Watchdog (SAF-08, E-036): Hängt der Regeltask länger als 5 s, startet
# der Chip neu und beginnt in BEREIT mit Ausgang 0 (SAF-10).
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5

# Eigene Partitionstabelle mit LittleFS für die Weboberfläche (E-038)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Netzwerk (E-039): Der HTTP-Server braucht für 8 Verbindungen 11 Sockets,
# der DNS-Server einen. Handys schicken bei der Prüfung auf ein Captive
# Portal lange Kopfzeilen.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# WebSocket /ws für die Livewerte (API-03)
CONFIG_HTTPD_WS_SUPPORT=y
