{
  "name": "raeucherofen-web",
  "private": true,
  "version": "1.0.0",
  "description": "Weboberfläche der Räucherofensteuerung (M9)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "openapi-typescript ../docs/api.yaml --output src/api/schema.d.ts",
    "dev": "npm run generate && vite",
    "lint": "npm run generate && eslint .",
    "typecheck": "npm run generate && tsc --noEmit",
    "test": "npm run generate && vitest run",
    "build": "npm run generate && tsc --noEmit && vite build"
  },
  "dependencies": {
    "preact": "10.29.8",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.6",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
